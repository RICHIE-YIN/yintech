# Where the audit request form delivers. Any service that accepts a plain
# HTML POST works (Formspree, Basin, Web3Forms). Until this is set, the
# contact page shows a "not connected" notice instead of a form — a form
# without a destination silently loses every request.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional direct contact routes. Anything left blank simply is not rendered,
# so nothing fabricated ever appears on the page.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BOOKING_URL=
